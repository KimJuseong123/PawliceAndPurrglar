# Copy to /srv/pawlice/server/.env on the instance and fill in.
#
#   sudo -u pawlice install -m 600 /dev/null /srv/pawlice/server/.env
#   sudo -u pawlice nano /srv/pawlice/server/.env
#
# Mode 600 matters: this file carries a billable API key on a machine whose
# only job is to serve a public page.

# Bound to loopback. nginx is the only thing that reaches it.
HOST=127.0.0.1
PORT=3000

# Leave empty to run the deterministic stub instead of real speech-to-text.
# The game still plays; voice commands fall back to the number keys.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# The page's own origin, now that the game and the API share a host. A blank
# list is not "allow everything" in this server — set it.
VOICE_ALLOWED_ORIGINS=https://pawlice.duckdns.org

# LEAVE THIS EMPTY for the WebGL build.
#
# The server refuses a session registration whose key does not match, and the
# game has no field to send one in — `VoiceSessionRegistrationRequest` carries
# the session id, the host id and the participants, and nothing else. Setting it
# therefore rejects every registration, no capability token is ever issued, and
# the player sees the voice key fail the instant they press it. The game itself
# looks broken; nothing in it mentions a key.
#
# Filling it in would not buy anything either. A WebGL build is fully readable
# by anyone who downloads it, so a secret compiled into the client is not a
# secret. This is for a deployment whose host is a machine you control.
VOICE_SESSION_REGISTRATION_KEY=

VOICE_RATE_LIMIT_PER_MINUTE=20
VOICE_COMMAND_MAX_DURATION_SECONDS=5
VOICE_COMMAND_MAX_FILE_SIZE_MB=5

# Must stay false in anything a judge can reach. It lets a request carry a
# transcript instead of audio, which is a way to put words in a player's mouth.
VOICE_ALLOW_TRANSCRIPT_OVERRIDE=false
