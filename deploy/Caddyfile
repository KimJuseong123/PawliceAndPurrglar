# Caddy serves the game and the voice API from one origin.
#
# One origin is not tidiness, it is a requirement. The page is https, so a call
# to http://localhost:3000 is blocked outright by the browser, and the
# microphone does not exist at all outside a secure context. Putting the API
# under /api on the same host means the WebGL build can resolve its backend
# from its own URL and never has an address compiled into it.
#
# There is no game port here. Matches go through Unity Relay, so nothing but
# 80 and 443 ever has to be open — see docs/21_REMOTE_PLAY_AND_DEPLOY.md.
#
# The domain comes from the environment so this file is the same on every
# machine:  PAWLICE_DOMAIN=pawlice.duckdns.org

{$PAWLICE_DOMAIN} {
	encode {
		zstd
		gzip
		# Only what compresses. The Unity payload is already compressed inside
		# its own container, and running gzip over it again costs CPU on a
		# 1GB instance for no bytes saved.
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
		}
	}

	# The voice API and its WebSocket. reverse_proxy upgrades connections on
	# its own, so /api/game/voice-events needs no special case.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /health {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /srv/pawlice/web
		try_files {path} /index.html
		file_server
	}

	# The payload is content-addressed by build, not by name, so a browser that
	# has it must not ask again. index.html is deliberately not covered: it is
	# what tells the browser which build to fetch.
	header /Build/* Cache-Control "public, max-age=31536000, immutable"
	header /StreamingAssets/* Cache-Control "public, max-age=604800"

	log {
		output file /var/log/caddy/pawlice.log
		format console
	}
}
