[Unit]
Description=Pawlice and Purrglar voice API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pawlice
Group=pawlice
WorkingDirectory=/srv/pawlice/server

# Bound to loopback on purpose. nginx is the only thing that should reach it,
# and a service listening on 0.0.0.0 is one security-group edit away from being
# an open transcription endpoint with somebody's API key behind it.
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NODE_ENV=production
EnvironmentFile=/srv/pawlice/server/.env

ExecStart=/usr/bin/node dist/src/index.js
Restart=on-failure
RestartSec=5

# A crash loop that rewrites the same error forever is how a 8GB disk fills up
# on a machine nobody is watching.
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/pawlice/server

[Install]
WantedBy=multi-user.target
